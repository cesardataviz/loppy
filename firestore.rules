rules_version = '2';

// Reglas de seguridad de Loppy.
// - Cada persona solo puede leer y escribir SU documento (users/{suId}) y sus intentos.
// - Nadie puede listar a los demás usuarios desde la app (eso solo se ve en la consola de Firebase).
// - Se validan los datos: campos permitidos, tipos y límites razonables.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isCount(v, max) {
      return v is int && v >= 0 && v <= max;
    }

    function isDayOrNull(v) {
      return v == null || (v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function validProgress(d) {
      return d.keys().hasOnly([
          'name', 'email', 'createdAt', 'lastSeenAt', 'epoch',
          'xp', 'level', 'solved', 'streak', 'bestStreak', 'lastActive',
          'todayDate', 'todayXp', 'dailyGoal', 'completed', 'attempts', 'history'
        ])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.email == request.auth.token.email
        && d.lastSeenAt == request.time
        && isCount(d.epoch, 1000000)
        && isCount(d.xp, 100000)
        && d.level is string && d.level.size() <= 40
        && isCount(d.solved, 5000)
        && isCount(d.streak, 100000)
        && isCount(d.bestStreak, 100000)
        && isDayOrNull(d.lastActive)
        && isDayOrNull(d.todayDate)
        && isCount(d.todayXp, 100000)
        && isCount(d.dailyGoal, 1000)
        && d.completed is map && d.completed.size() <= 5000
        && d.attempts is map && d.attempts.size() <= 5000
        && d.history is map && d.history.size() <= 20000;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;

      allow create: if isOwner(uid)
        && validProgress(request.resource.data)
        && request.resource.data.createdAt == request.time;

      // epoch nunca baja: un dispositivo desactualizado no puede pisar un reinicio.
      allow update: if isOwner(uid)
        && validProgress(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.epoch >= resource.data.epoch;

      allow delete: if isOwner(uid);

      match /attempts/{attemptId} {
        allow read, delete: if isOwner(uid);
        // create o reenvío idéntico (si se cortó el internet a mitad del envío).
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['exerciseId', 'passed', 'day', 'at'])
          && request.resource.data.exerciseId is string && request.resource.data.exerciseId.size() <= 80
          && request.resource.data.passed is bool
          && isDayOrNull(request.resource.data.day) && request.resource.data.day != null
          && request.resource.data.at is timestamp
          && request.resource.data.at <= request.time + duration.value(5, 'm');
      }
    }

    // --- Ranking público: nombre, país y XP (nunca el correo). Lo ve cualquiera. ---
    // Días y semanas en hora UTC-5; la semana empieza el lunes (igual que src/cloud/ranking.ts).
    function rankDay() {
      return math.floor((request.time.toMillis() - 18000000) / 86400000);
    }
    function rankWeek() {
      return math.floor((rankDay() + 3) / 7);
    }

    function validRank(d) {
      return d.keys().hasOnly(['name', 'country', 'hidden', 'xp', 'week', 'weekXp', 'day', 'dayXp', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.country is string && d.country.matches('^([A-Z]{2})?$')
        && d.hidden is bool
        && isCount(d.xp, 100000)
        && d.week == rankWeek() && d.day == rankDay()
        && isCount(d.weekXp, 100000) && d.weekXp <= d.xp
        && isCount(d.dayXp, 2000)
        && d.updatedAt == request.time;
    }

    // Anti-trampas: el XP solo sube lo que se suma al contador del día (máximo 2000 por día).
    // Bajar siempre se puede (reiniciar progreso).
    function validRankChange(d, o) {
      let prevDay = o.day == rankDay() ? o.dayXp : 0;
      let prevWeek = o.week == rankWeek() ? o.weekXp : 0;
      let gain = d.xp - o.xp;
      return gain <= 0
        ? d.dayXp == prevDay && d.weekXp <= prevWeek
        : d.dayXp == prevDay + gain && d.weekXp == prevWeek + gain;
    }

    match /ranking/{uid} {
      allow read: if true;

      // Primera vez: como máximo 2000 XP por cada día que tiene la cuenta.
      allow create: if isOwner(uid)
        && validRank(request.resource.data)
        && request.resource.data.dayXp == 0
        && request.resource.data.weekXp <= 14000
        && request.resource.data.xp <= 2000 * (math.floor((request.time.toMillis()
             - get(/databases/$(database)/documents/users/$(uid)).data.createdAt.toMillis()) / 86400000) + 1);

      allow update: if isOwner(uid)
        && validRank(request.resource.data)
        && validRankChange(request.resource.data, resource.data);

      // Solo junto con borrar la cuenta (si no, alguien podría borrar y recrear para saltarse el tope).
      allow delete: if isOwner(uid)
        && !existsAfter(/databases/$(database)/documents/users/$(uid));
    }

    // Todo lo demás está cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
